<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <!--
        The schema is created and controlled by src/main/resources/schema.sql,
        so Hibernate must never alter it.

        Connection credentials are intentionally absent from this file. They are
        supplied programmatically from the environment at EntityManagerFactory
        creation time, so no credential is ever stored in source control.
    -->
    <persistence-unit name="resqgrid">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>persistence.entity.LocationEntity</class>
        <class>persistence.entity.IncidentEntity</class>
        <class>persistence.entity.ResourceEntity</class>
        <class>persistence.entity.ResponseTeamEntity</class>
        <class>persistence.entity.CapabilityEntity</class>
        <class>persistence.entity.DispatchEntity</class>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>

            <property name="jakarta.persistence.schema-generation.database.action"
                      value="none"/>

            <property name="hibernate.hbm2ddl.auto" value="none"/>

            <property name="hibernate.show_sql" value="false"/>

        </properties>

    </persistence-unit>

</persistence>